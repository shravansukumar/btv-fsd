# Copy to .env and adjust as needed: cp .env.example .env

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1

# Postgres (matches docker-compose.yml). The assignment stack is PostgreSQL.
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Set to 1 to use a local SQLite file instead of Postgres (handy if you don't
# want to run Docker). Leave unset/0 to use Postgres.
USE_SQLITE=0
